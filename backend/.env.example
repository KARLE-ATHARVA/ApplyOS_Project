
# Comma-separated frontend origins allowed by the API.
# Local development:
FRONTEND_ORIGIN=http://localhost:5173

# For deployment, replace the value above with your actual frontend origin.
# Example:
# FRONTEND_ORIGIN=https://your-frontend.example.com

# Local API bind settings.
# Do not expose the development server publicly without production hardening.
API_HOST=127.0.0.1
API_PORT=8000
